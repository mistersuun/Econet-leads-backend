# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/econet_leads
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration (REQUIRED - No defaults provided for security)
# Generate secure random strings at least 32 characters long
# Example: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-at-least-32-characters-long-change-this
JWT_REFRESH_SECRET=your-different-256-bit-secret-for-refresh-tokens-change-this

# Redis Configuration (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Geocoding API (optional)
GOOGLE_MAPS_API_KEY=

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Environment
SPRING_PROFILES_ACTIVE=local
