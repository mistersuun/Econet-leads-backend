# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/econet_leads
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration (REQUIRED outside the local profile - startup fails if missing or < 32 bytes)
# Generate each one with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Bootstrap admin password (used only when no admin exists; random + logged once if empty)
ADMIN_INITIAL_PASSWORD=

# Browser origins allowed by CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis Configuration (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Geocoding API (optional)
GOOGLE_MAPS_API_KEY=

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Environment
SPRING_PROFILES_ACTIVE=local
